# Google Gemini — traduction wolof ↔ français
GOOGLE_API_KEY=
# Modèle de traduction wolof <-> français
TRANSLATION_MODEL=gemini-3.6-flash

# Groq — agent de raisonnement et appel des tools
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# STT
# Choix : whisper_local, elevenlabs, dikkte
STT_PROVIDER=whisper_local
ELEVENLABS_API_KEY=
# small/base pour CPU (large-v3 est trop lourd sur 16Go RAM)
WHISPER_MODEL_SIZE=small
# Langue forcée pour faster-whisper : 'wo', 'fr' ; vide = auto-détection
STT_LANGUAGE=
# Modèle Hugging Face ASR wolof (utilisé si STT_PROVIDER=dikkte)
HF_STT_MODEL=

# TTS
TTS_PROVIDER=oolel
TTS_VOICE_SAMPLE_PATH=app/assets/Vocal_1.m4a
HF_TOKEN=

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=assistabt_voices_db

# Audio output (généré par le TTS)
TMP_AUDIO_DIR=app/assets/audio
